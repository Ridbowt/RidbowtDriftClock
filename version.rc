1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x00040004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ridbowt"
            VALUE "FileDescription",  "RidbowtDriftClock - drifting LED clock screensaver"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "RidbowtDriftClock"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ridbowt"
            VALUE "OriginalFilename", "RidbowtDriftClock.scr"
            VALUE "ProductName",      "RidbowtDriftClock"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Release date: 2026-11-24 | https://github.com/Ridbowt/RidbowtDriftClock"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END